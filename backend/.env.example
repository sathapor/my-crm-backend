# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
# URL ของหน้าบ้านที่อนุญาตให้เชื่อมต่อ (CORS)
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# URL ของ Backend เอง (เอาไว้ทำ Self-Ping บน Render)
PUBLIC_URL=http://localhost:5000

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co
# ใช้อนุญาตการเข้าถึงทั่วไป (ฝั่ง Client)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# ใช้สำหรับ Backend เพื่อจัดการฐานข้อมูลข้ามสิทธิ์ (ห้ามให้ใครรู้เด็ดขาด)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# รหัสลับสำหรับสร้าง JWT Token (ตั้งให้ยากๆ)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# ==========================================
# LINE MESSAGING API
# ==========================================
LINE_API_NUMBER=your_line_api_number
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_ACCESS_TOKEN=your_line_access_token_here

# ==========================================
# FACEBOOK CONFIGURATION (ถ้ามี)
# ==========================================
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
